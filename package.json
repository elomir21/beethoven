{
  "name": "beethoven-o-caminho-de-casa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build && npm run build:offline",
    "build:offline": "node --experimental-vm-modules scripts/build.mjs --offline-only",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "start": "node scripts/serve.mjs dist",
    "dev:offline": "node scripts/serve.mjs",
    "build:legacy": "node --experimental-vm-modules scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:logic",
    "test:unit": "vitest run",
    "test:logic": "node --experimental-vm-modules --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:visual": "node tests/visual-mobile.mjs",
    "test:story": "node tests/parallax-family.mjs",
    "verify": "npm run build && npm test && npm run test:e2e && npm run test:visual && npm run test:story"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "playwright": "^1.56.1"
  }
}
